# Standalone Node.js WhatsApp Web QR Bridge Service (@wacrm/qr-service)
# Host this on a persistent VPS/container volume (DO NOT use ephemeral storage or Cloudflare Workers).

PORT=8790
HOST=0.0.0.0

# Must match QR_BRIDGE_SECRET set on apps/api (min 32 random chars recommended):
QR_BRIDGE_SECRET=replace-with-at-least-32-chars-bridge-hmac-secret

# Strong key (>= 32 chars) used to AES-256-GCM encrypt Baileys session auth files on disk:
QR_SESSION_ENCRYPTION_KEY=replace-with-at-least-32-chars-aes-session-key

# Persistent disk directory mounted from a Docker / VPS volume:
QR_STORAGE_DIR=/var/lib/wacrm-qr-sessions

# Optional webhook URL pointing back to Cloudflare API `/webhooks/qr-bridge`:
API_WEBHOOK_URL=http://127.0.0.1:8787/webhooks/qr-bridge

# QR expiration countdown in milliseconds (default 60s matching WhatsApp Web QR cycle):
QR_TTL_MS=60000
